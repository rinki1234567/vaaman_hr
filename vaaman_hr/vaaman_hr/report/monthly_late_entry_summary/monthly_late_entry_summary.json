 "query": "SELECT\n    employee,\n    employee_name,\n    MONTH(attendance_date) AS month,\n    COUNT(CASE WHEN late_entry = 1 THEN 1 END) AS late_entries,\n    COUNT(CASE WHEN early_exit = 1 THEN 1 END) AS early_exits\nFROM `tabAttendance`\nWHERE attendance_date BETWEEN %(from_date)s AND %(to_date)s\nGROUP BY employee, month\nORDER BY month, employee\n",
